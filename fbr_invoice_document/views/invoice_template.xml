<odoo>

    <record id="paperformat_fbr_invoice" model="report.paperformat">
        <field name="name">paperformat.fbr.invoice</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="page_width">0</field>
        <field name="page_height">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">27</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_invoice_fbr" model="ir.actions.report">
        <field name="name">FBR INV</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fbr_invoice_document.template_fbr_invoice</field>
        <field name="report_file">fbr_invoice_document.template_fbr_invoice</field>
        <field name="print_report_name">'FBR INV - %s' % (object.partner_id.name)</field>
        <field name="paperformat_id" ref="fbr_invoice_document.paperformat_fbr_invoice"/>  
        <field name="binding_model_id" ref="account.model_account_move"/>
    </record>


    <template id="fbr_invoice_document_layout">
        <t t-foreach="docs" t-as="o">
            <div class="header" style="margin-top:20px;">
                <div class="row">
                    <br/>
                    <br/>
                    <div class="col-10">
                    <br/>
                    <br/>
                    <br/>
                        <h2 style="font-weight:bolder;margin-top:20px;">
                         <img t-if="o.company_id.logo and o.company_id.show_company_logo_fbr" t-att-src="image_data_uri(o.company_id.logo)"
                                style="height: 100px; width: auto; max-width: 100px; object-fit: contain;"/>
                        <span t-if="o.company_id.show_company_logo_fbr" t-esc="o.company_id.name"/></h2>
                        
                    </div>
                    <div class="col-9 row"  style="text-align:right;margin-top:20px;">


                       <img src="/fbr_invoice_document/static/description/icon.png" style="height:130px;width:130px;margin-right:25px;"/>
                       

                          <span t-if="o.qr_code_image"
                                t-field="o.qr_code_image"
                                t-options="{'widget': 'image', 'alt-field': 'QR Code', 'width': 165, 'height': 165}"/>



                    </div>
                </div>
            </div>
            <div class="article o_report_layout_standard">
                <t t-out="0"></t>
            </div>
            <div class="footer o_standard_footer text-center">
                <div class="row">
                
                    <div class="col-11"></div>
                    <div class="col-1">
                        <b>
                            Page <span class="page"/> of <span class="topage"/>
                        </b>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="template_fbr_invoice" >
        <t t-call="fbr_invoice_document.fbr_invoice_document_layout">
            <t t-foreach="docs" t-as="o">


                <main>
                    <div class="row" style="margin-top:20px;">
                        <div class="col-4">
                            <b>Seller Information</b>

                            <table style="border:0px white solid;font-size:12px;text-align:left;">
                                <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px; white-space: nowrap;">
                                    Business Name:
                                    </th>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    <span t-esc="o.company_id.name"/>
                                    </th>
                                </tr>

                                <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    Address:
                                    </th>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    <span t-esc="', '.join(filter(None, [ o.company_id.street, o.company_id.street2, o.company_id.city, o.company_id.state_id.name, o.company_id.country_id.name ]))"/>
                                    </th>
                                </tr>

                                <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px; white-space: nowrap;">
                                    Registration No.:
                                    </th>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    <span t-esc="o.company_id.vat"/>
                                    </th>
                                </tr>

                                <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    Province:
                                    </th>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    <span t-esc="o.company_id.state_id.name"/>
                                    </th>
                                </tr>

                            </table>
                        </div>
                        <div class="col-4">
                            <b>Buyer Information</b>


                            <table style="border:0px white solid;font-size:12px;text-align:left;">
                                <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px; white-space: nowrap;">
                                    Business Name:
                                    </th>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    <span t-esc="o.partner_id.name"/>
                                    </th>
                                </tr>
                                <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    Address:
                                    </th>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    <span t-esc="', '.join(filter(None, [ o.partner_id.street, o.partner_id.street2, o.partner_id.city, o.partner_id.state_id.name, o.partner_id.country_id.name ]))"/>
                                    </th>
                                </tr>

                                <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px; white-space: nowrap;">
                                    Registration No.:
                                    </th>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    <span t-esc="o.partner_id.vat"/>
                                    </th>
                                </tr>

                                <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    Province:
                                    </th>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    <span t-esc="o.partner_id.state_id.name"/>
                                    </th>
                                </tr>


                            </table>
                        </div>
                        <div class="col-4">
                            <b>Invoice Summary</b>
                            <table style="border:0px white solid;font-size:12px;text-align:left;">
                                <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px; white-space: nowrap;">
                                        FBR Invoice No.: 
                                    </th>
                                   <t t-if="o.fbr_invoice_number">
                                        <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                            <t t-esc="o.fbr_invoice_number"/>
                                        </th>
                                    </t>
                                    <t t-else="">
                                        <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                            B432031DI1756817886353
                                        </th>
                                    </t>

                                </tr>

                                 <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                        Invoice No.:
                                    </th>
                                   <t t-if="o.name">
                                        <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                            <t t-esc="o.name"/>
                                        </th>
                                    </t>


                                </tr>

                                <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                        Invoice Date:
                                    </th>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                        <t t-esc="o.invoice_date.strftime('%d-%b-%Y') if o.invoice_date else ''"/>
                                    </th>

                                </tr>

                                 <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    Invoice Type:
                                    </th>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                    Sale Invoice
                                    </th>
                                </tr>

                                <tr>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                        Tax Period:
                                    </th>
                                    <th colspan="2" style="padding-top: 2px; padding-bottom: 2px;">
                                        <t t-esc="o.invoice_date.strftime('%Y%m') if o.invoice_date else ''"/>
                                    </th>
                                </tr>

                            </table>

                        </div>
                    </div>



                    <table style="width:100%; border-collapse:collapse; margin-top:15px; font-size:11px; text-align:center;">
                        <thead>
                            <tr style="background-color:#f2f2f2; font-weight:bold; border:1px solid #000;">
                                <th style="border:1px solid #000; padding:4px;">Sr. No.</th>
                                <th style="border:1px solid #000; padding:4px;">HS Code</th>
                                <!-- <th style="border:1px solid #000; padding:4px;">HS Code Description</th> -->
                                <th style="border:1px solid #000; padding:4px;">Product Description</th>
                                <th style="border:1px solid #000; padding:4px;">Sales Type</th>
                                <th style="border:1px solid #000; padding:4px;">Quantity</th>
                                <th style="border:1px solid #000; padding:4px;">UoM</th>
                                <th style="border:1px solid #000; padding:4px;">Rate</th>
                                <th style="border:1px solid #000; padding:4px;">Sales Value</th>
                                <th style="border:1px solid #000; padding:4px;">Retail Price</th>
                                <th style="border:1px solid #000; padding:4px;">Sales Tax 18%</th>
                                <th style="border:1px solid #000; padding:4px;">Extra Tax</th>
                                <th style="border:1px solid #000; padding:4px;">Further Tax</th>
                                <th style="border:1px solid #000; padding:4px;">FED</th>
                                <th style="border:1px solid #000; padding:4px;">ST WHT</th>
                                <th style="border:1px solid #000; padding:4px;">Discount</th>
                                 <th style="border:1px solid #000; padding:4px;">Total</th>
                                <th style="border:1px solid #000; padding:4px;">SRO / Schedule No.</th>
                                <th style="border:1px solid #000; padding:4px;">SRO Item</th>
                               
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="docs.invoice_line_ids.filtered(lambda l: l.display_type == 'product')" t-as="l">
                                <tr>
                                    <td style="border:1px solid #000; padding:3px;"><span t-esc="l_index+1"/></td>
                                    <td style="border:1px solid #000; padding:3px;"><t t-esc="l.product_id.fbr_hs_code or ''"/></td>
                                    <!-- <td style="border:1px solid #000; padding:3px;"><t t-esc="l.product_id.fbr_hs_code or ''"/></td> -->
                                    <td style="border:1px solid #000; padding:3px;"><t t-esc="l.product_id.display_name or ''"/></td>
                                    <td style="border:1px solid #000; padding:3px;"><t t-esc="l.product_id.fbr_scenario_id.name or ''"/></td>
                                    <td style="border:1px solid #000; padding:3px; text-align:right;"><t t-esc="l.quantity"/></td>
                                    <td style="border:1px solid #000; padding:3px;"><t t-esc="l.product_id.fbr_uom_id.name or ''"/></td>
                                    <td style="border:1px solid #000; padding:3px; text-align:right;"><t t-esc="'{:,.2f}'.format(l.price_unit or 0.0)"/></td>
                                    <td style="border:1px solid #000; padding:3px; text-align:right;"><t t-esc="'{:,.2f}'.format(l.price_subtotal or 0.0)"/></td>
                                    <td style="border:1px solid #000; padding:3px; text-align:right;">0.00</td>
                                    <td style="border:1px solid #000; padding:3px; text-align:right;"><t t-esc="'{:,.2f}'.format(l.fbr_sales_tax or 0.0)"/></td>
                                    <td style="border:1px solid #000; padding:3px; text-align:right;"><t t-esc="'{:,.2f}'.format(l.fbr_extra_tax or 0.0)"/></td>
                                    <td style="border:1px solid #000; padding:3px; text-align:right;"><t t-esc="'{:,.2f}'.format(l.fbr_further_tax or 0.0)"/></td>
                                    <td style="border:1px solid #000; padding:3px; text-align:right;"><t t-esc="'{:,.2f}'.format(l.fbr_fed_payable or 0.0)"/></td>
                                    <td style="border:1px solid #000; padding:3px; text-align:right;"><t t-esc="'{:,.2f}'.format(l.fbr_withholding_tax or 0.0)"/></td>
                                    <td style="border:1px solid #000; padding:3px; text-align:right;"><t t-esc="'{:,.2f}'.format(l.discount or 0.0)"/></td>
                                     <td style="border:1px solid #000; padding:3px;"><t t-esc="'{:,.2f}'.format(l.price_total or 0.0)"/></td>
                                    <td style="border:1px solid #000; padding:3px;"><t t-esc="l.product_id.fbr_sro_item_serial_no_id.name or ''"/></td>
                                    <td style="border:1px solid #000; padding:3px;"><t t-esc="l.product_id.fbr_sro_schedule_no_id.name or ''"/></td>
                                   
                                    
                                </tr>
                            </t>
                        </tbody>
                    </table>

                       
                </main>
            </t>
        </t>
    </template>



</odoo>   