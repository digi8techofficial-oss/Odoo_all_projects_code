        <!-- First, change the condition that displays the column.
                 It will now show if *any* line has a value in 'discount_fixed'. -->
            <xpath expr="//t[@t-set='display_discount']" position="replace">
                <t t-set="display_discount" t-value="any(l.discount_fixed for l in o.invoice_line_ids)"/>
            </xpath>

            <!-- Second, change the header text for the discount column. -->
            <xpath expr="//th[@name='th_discount']/span" position="replace">
                <span>Discount Amount (RS)</span>
            </xpath>

            <!-- Third, change the line cell to show the new 'discount_fixed' field.
                 We format it as a monetary value. -->
            <xpath expr="//td[@name='td_discount']/span" position="replace">
                <!-- <span t-field="line.discount_fixed" t-options='{"widget": "monetary"}'/> -->
                 <!-- <span t-esc="int(round(line.discount_fixed or 0))"/> -->
                 <span t-field="line.discount_fixed" t-options="{'widget': 'float', 'precision': 0}"/>
            </xpath>
